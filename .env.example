# MongoDB
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/launchfund

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Stripe (Connect + Checkout)
# Get the secret and publishable keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create a webhook endpoint pointed at /api/stripe/webhook
# Listen for: checkout.session.completed, payment_intent.payment_failed, charge.refunded, account.updated
STRIPE_WEBHOOK_SECRET=whsec_...

# Platform fee charged to backers on each pledge, in basis points.
# 400 = 4%  (matches the Creator Pro tier). Max 2000 (20%).
STRIPE_PLATFORM_FEE_BPS=400

# Optional: public URL of the deployed app, used in Stripe success/cancel URLs if NEXTAUTH_URL isn't set.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
